# Supabase (Project Settings -> API)
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key   # never expose this to the client

# Lemon Squeezy (Settings -> API)
LEMONSQUEEZY_API_KEY=your-lemonsqueezy-api-key
LEMONSQUEEZY_STORE_ID=your-store-id
LEMONSQUEEZY_WEBHOOK_SECRET=your-webhook-signing-secret

# Your site's public URL (used for checkout redirect + emails)
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Admin login for the /admin upload panel
ADMIN_PASSWORD=choose-a-strong-password
ADMIN_COOKIE_SECRET=choose-a-random-long-string
